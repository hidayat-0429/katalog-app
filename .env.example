# Ganti dengan koneksi PostgreSQL kamu (lokal atau Supabase/Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/katalog_db"
# DIRECT_URL digunakan untuk migrasi Prisma direct connection
DIRECT_URL="postgresql://user:password@localhost:5432/katalog_db"

# NextAuth
NEXTAUTH_SECRET="ganti-dengan-string-acak-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Admin Kontak (Nomor resmi format internasional tanpa '+', contoh: 628113503650)
NEXT_PUBLIC_ADMIN_PHONE="628113503650"

# Kredensial akun bawaan untuk seeding database
ADMIN_SEED_PASSWORD="admin123"
BUYER_SEED_PASSWORD="buyer123"

# Supabase Storage (untuk upload gambar produk)
# Dapatkan di: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
